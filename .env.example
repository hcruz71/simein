# Variables de entorno de SIMEIN. En Heroku las define el add-on Stackhero for MySQL
# (STACKHERO_MYSQL_*) y `heroku config:set` (el resto). Copia a .env para `heroku local`.
STACKHERO_MYSQL_HOST=
STACKHERO_MYSQL_PORT=
STACKHERO_MYSQL_ROOT_PASSWORD=
DB_USER=
DB_NAME=
TZ=
# Opcional: URL base para que el login llame a la API (por defecto http://127.0.0.1:$PORT)
APP_URL=
